rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function validText(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function userCanWrite(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return signedIn() && request.auth.uid == userId &&
        (!('requiresEmailVerification' in userDoc.data) || request.auth.token.email_verified == true);
    }

    match /orders/{orderId} {
      allow create: if signedIn() &&
        request.auth.token.role in ['personalTrainer', 'admin'] &&
        request.resource.data.keys().hasAll(['userId', 'userName', 'sessions', 'price', 'status', 'createdAt', 'assignedTrainerId']) &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'sessions', 'price', 'status', 'createdAt', 'assignedTrainerId']) &&
        validText(request.resource.data.userId, 1, 128) &&
        validText(request.resource.data.userName, 1, 60) &&
        request.resource.data.sessions in [1, 5, 10] &&
        ((request.resource.data.sessions == 1 && request.resource.data.price == 2000) ||
         (request.resource.data.sessions == 5 && request.resource.data.price == 9000) ||
         (request.resource.data.sessions == 10 && request.resource.data.price == 16000)) &&
        request.resource.data.status == 'unpaid' &&
        request.resource.data.createdAt == request.time &&
        (hasRole('admin') ||
          (request.resource.data.assignedTrainerId == request.auth.uid &&
           get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.assignedTrainerId == request.auth.uid));

      allow get: if signedIn() &&
        (request.auth.uid == resource.data.userId || hasRole('admin') || resource.data.assignedTrainerId == request.auth.uid);

      allow list: if signedIn() &&
        (hasRole('admin') || (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid));

      allow update: if signedIn() &&
        (hasRole('admin') || (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt']) &&
        resource.data.status == 'unpaid' && request.resource.data.status == 'paid' &&
        request.resource.data.paidAt == request.time;

      allow delete: if false;
    }

    match /experienceBookings/{bookingId} {
      allow create: if userCanWrite(request.auth.uid) && bookingId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'userName', 'email', 'preferredTime', 'status', 'assignedTrainerId', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'email', 'preferredTime', 'status', 'assignedTrainerId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name &&
        request.resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email &&
        request.resource.data.preferredTime in [
          '平日早上 (09:00–12:00)', '平日下午 (13:00–17:00)', '平日晚上 (18:00–21:00)',
          '週末早上 (09:00–12:00)', '週末下午 (13:00–17:00)', '週末晚上 (18:00–21:00)'
        ] &&
        request.resource.data.status == 'pending' && request.resource.data.assignedTrainerId == '' &&
        request.resource.data.createdAt == request.time;

      allow get: if signedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.assignedTrainerId == request.auth.uid || hasRole('admin'));

      allow list: if signedIn() &&
        (hasRole('admin') ||
         (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid) ||
         resource.data.userId == request.auth.uid);

      allow update: if signedIn() &&
        ((hasRole('admin') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTrainerId', 'status'])) ||
         (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status in ['contacted', 'attended']));

      allow delete: if false;
    }

    match /groupSchedule/{docId} {
      allow read: if true;
      allow create: if hasRole('admin') &&
        request.resource.data.keys().hasAll(['title', 'coach', 'date', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['title', 'coach', 'date', 'startTime', 'endTime', 'createdAt']) &&
        request.resource.data.title in ['Zumba', 'Yoga', '有氧拳擊', '飛輪', '核心訓練'] &&
        validText(request.resource.data.coach, 1, 60) &&
        request.resource.data.date is timestamp &&
        validText(request.resource.data.startTime, 5, 5) && validText(request.resource.data.endTime, 5, 5) &&
        request.resource.data.startTime != request.resource.data.endTime &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if hasRole('admin');
    }

    match /privateSchedule/{docId} {
      allow create: if hasRole('personalTrainer') &&
        request.resource.data.keys().hasAll(['trainerId', 'studentId', 'studentType', 'date', 'startTime', 'endTime', 'isAttended']) &&
        request.resource.data.keys().hasOnly(['trainerId', 'studentId', 'studentType', 'date', 'startTime', 'endTime', 'isAttended']) &&
        request.resource.data.trainerId == request.auth.uid &&
        validText(request.resource.data.studentId, 1, 128) &&
        request.resource.data.studentType in ['normal', 'experience'] &&
        validText(request.resource.data.date, 10, 10) &&
        validText(request.resource.data.startTime, 5, 5) && validText(request.resource.data.endTime, 5, 5) &&
        request.resource.data.startTime != request.resource.data.endTime &&
        request.resource.data.isAttended == false;

      allow get, list: if signedIn() &&
        ((hasRole('personalTrainer') && resource.data.trainerId == request.auth.uid) || request.auth.uid == resource.data.studentId);

      allow update: if hasRole('personalTrainer') && resource.data.trainerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAttended']) &&
        request.resource.data.isAttended is bool;

      allow delete: if hasRole('personalTrainer') && resource.data.trainerId == request.auth.uid;
    }

    match /groupBookings/{bookingId} {
      allow create: if userCanWrite(request.auth.uid) &&
        request.resource.data.keys().hasAll(['userId', 'groupClassId', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['userId', 'groupClassId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        validText(request.resource.data.groupClassId, 1, 128) &&
        bookingId == request.auth.uid + '_' + request.resource.data.groupClassId &&
        exists(/databases/$(database)/documents/groupSchedule/$(request.resource.data.groupClassId)) &&
        request.resource.data.createdAt == request.time;

      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || hasRole('admin') || hasRole('groupCoach'));
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || hasRole('admin'));
      allow update: if false;
    }

    match /users/{userId} {
      allow get, list: if signedIn() &&
        (request.auth.uid == userId || hasRole('admin') ||
         (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid));

      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['name', 'email', 'role', 'isFormalMember', 'remainingSessions', 'requiresEmailVerification', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'role', 'isFormalMember', 'remainingSessions', 'requiresEmailVerification', 'createdAt']) &&
        validText(request.resource.data.name, 2, 40) &&
        validText(request.resource.data.email, 6, 254) && request.resource.data.email == request.auth.token.email &&
        request.resource.data.role == 'member' && request.resource.data.isFormalMember == false &&
        request.resource.data.remainingSessions == 0 && request.resource.data.requiresEmailVerification == true &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        ((request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          validText(request.resource.data.name, 2, 40)) ||
         (hasRole('personalTrainer') && resource.data.assignedTrainerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFormalMember', 'assignedTrainerId', 'remainingSessions', 'totalPurchasedSessions'])) ||
         hasRole('admin'));
      allow delete: if false;

      match /bodyMetrics/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if userCanWrite(userId) &&
          request.resource.data.keys().hasAll(['height', 'weight', 'bodyFat', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['height', 'weight', 'bodyFat', 'createdAt']) &&
          request.resource.data.height is number && request.resource.data.height >= 100 && request.resource.data.height <= 250 &&
          request.resource.data.weight is number && request.resource.data.weight >= 25 && request.resource.data.weight <= 350 &&
          request.resource.data.bodyFat is number && request.resource.data.bodyFat >= 2 && request.resource.data.bodyFat <= 70 &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /workouts/{docId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if userCanWrite(userId) &&
          request.resource.data.keys().hasAll(['date', 'exercises', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['date', 'exercises', 'createdAt']) &&
          validText(request.resource.data.date, 10, 10) &&
          request.resource.data.exercises is list && request.resource.data.exercises.size() >= 1 && request.resource.data.exercises.size() <= 20 &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
